# MinIO Configuration
MINIO_ENDPOINT=https://minio.lokieee.in
MINIO_ACCESS_KEY=minioadmin 
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=image-captioning
MINIO_SECURE=true

# Dataset Configuration
MLOPS_DATASET=flickr8k

# Database Configuration (for experiments/model tracking, NOT for dataset storage)
POSTGRES_DSN=postgresql://mlops:mlops@localhost:5432/mlops

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=image-captioning
MLFLOW_REGISTERED_MODEL_NAME=image-captioner

# Model Configuration
DEVICE=cpu
